# ── Convex Backend ──────────────────────────────────────────
# عنوان Convex Cloud الخاص بالمشروع
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# ── Site URL ───────────────────────────────────────────────
# رابط الموقع النهائي (يُستخدم في إنشاء روابط الصفحات)
VITE_SITE_URL=https://satrunlines.com

# ── VLY Email Integration ──────────────────────────────────
# مفتاح VLY لإرسال البريد الإلكتروني (يُستخدم فقط في Convex Actions)
# ملاحظة: هذا المفتاح لا يظهر في الكود المصدري — فقط في بيئة التشغيل
VLY_INTEGRATION_KEY=sk_your_key_here

# ── Stripe (اختياري) ──────────────────────────────────────
# Stripe_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
